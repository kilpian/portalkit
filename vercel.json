{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {"source": "/privacy", "destination": "/privacy.html"},
    {"source": "/terms", "destination": "/terms.html"},
    {"source": "/thank-you", "destination": "/thank-you.html"},
    {"source": "/signin", "destination": "/app.html"},
    {"source": "/signin/sso-callback", "destination": "/app.html"},
    {"source": "/signin/factor-one", "destination": "/app.html"},
    {"source": "/signin/factor-two", "destination": "/app.html"},
    {"source": "/signup", "destination": "/app.html"},
    {"source": "/signup/sso-callback", "destination": "/app.html"},
    {"source": "/dashboard", "destination": "/app.html"},
    {"source": "/dashboard/(.*)", "destination": "/app.html"},
    {"source": "/portal/(.*)", "destination": "/app.html"},
    {"source": "/book/:username", "destination": "/app.html"},
    {"source": "/inquire/:username", "destination": "/app.html"},
    {"source": "/pay/:linkId", "destination": "/app.html"},
    {"source": "/proposal/:id", "destination": "/app.html"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Frame-Options", "value": "SAMEORIGIN"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"},
        {"key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload"}
      ]
    }
  ]
}
