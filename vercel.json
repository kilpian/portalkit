{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {"source": "/api/:path*", "destination": "https://portalkit-production.up.railway.app/api/:path*"},
    {"source": "/blog", "destination": "/blog/index.html"},
    {"source": "/blog/wedding-shot-list-guide", "destination": "/blog/wedding-shot-list-guide.html"},
    {"source": "/blog/wedding-photography-client-management", "destination": "/blog/wedding-photography-client-management.html"},
    {"source": "/blog/wedding-photographer-tools", "destination": "/blog/wedding-photographer-tools.html"},
    {"source": "/blog/p/:slug", "destination": "https://portalkit-production.up.railway.app/api/blog/:slug"},
    {"source": "/tools/shot-list", "destination": "/tools/shot-list.html"},
    {"source": "/tools/timeline", "destination": "/tools/timeline.html"},
    {"source": "/tools/questionnaire", "destination": "/tools/questionnaire.html"},
    {"source": "/tools/pricing-guide", "destination": "/tools/pricing-guide.html"},
    {"source": "/privacy", "destination": "/privacy.html"},
    {"source": "/terms", "destination": "/terms.html"},
    {"source": "/thank-you", "destination": "/thank-you.html"},
    {"source": "/accessibility", "destination": "/accessibility.html"},
    {"source": "/faq", "destination": "/faq.html"},
    {"source": "/signin", "destination": "/app.html"},
    {"source": "/signin/sso-callback", "destination": "/app.html"},
    {"source": "/signin/factor-one", "destination": "/app.html"},
    {"source": "/signin/factor-two", "destination": "/app.html"},
    {"source": "/signin/:path*", "destination": "/app.html"},
    {"source": "/signup", "destination": "/app.html"},
    {"source": "/signup/sso-callback", "destination": "/app.html"},
    {"source": "/signup/:path*", "destination": "/app.html"},
    {"source": "/sso-callback", "destination": "/app.html"},
    {"source": "/sso-callback/:path*", "destination": "/app.html"},
    {"source": "/dashboard", "destination": "/app.html"},
    {"source": "/dashboard/(.*)", "destination": "/app.html"},
    {"source": "/portal/(.*)", "destination": "/app.html"},
    {"source": "/book/:username", "destination": "/app.html"},
    {"source": "/inquire/:username", "destination": "/app.html"},
    {"source": "/pay/:linkId", "destination": "/app.html"},
    {"source": "/proposal/:id", "destination": "/app.html"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Frame-Options", "value": "SAMEORIGIN"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"},
        {"key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload"}
      ]
    }
  ]
}
